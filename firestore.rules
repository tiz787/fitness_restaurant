// REGLAS PARA FIRESTORE DATABASE
// Para instalarlas: Ve a la consola de Firebase -> Firestore Database -> Pestaña "Reglas" -> Pega este código
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario está conectado
    function isAuthenticated() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true; // Todos pueden ver el menú (incluso sin login)
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated(); 
      allow delete: if false; // Por seguridad, nunca se borran las órdenes
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated(); 
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
